PORT=4000
MONGO_URL=mongodb://localhost:27017/geobook
DATABASE_URL=postgres://geobook:geobook@localhost:5433/geobook
KAFKA_BROKERS=localhost:9092
# Host port only; containers always connect to postgres:5432.
POSTGRES_PORT=5433
# Use true only behind HTTPS. Local Compose uses HTTP.
SECURE_COOKIES=false
SEED_DEMO=true
# Optional: set before the FIRST demo seed to allow demo.owner@geobook.test login.
DEMO_PASSWORD=
MAPBOX_TOKEN=
# Account links always use this configured URL, never request headers.
# Use http://localhost:5173/ for the Vite development guest app.
PUBLIC_APP_URL=http://localhost:8080/
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GeoBook <no-reply@geobook.test>
# Optional Stripe sandbox checkout; live keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
