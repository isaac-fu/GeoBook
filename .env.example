PORT=4000
MONGO_URL=mongodb://localhost:27017/geobook
DATABASE_URL=postgres://geobook:geobook@localhost:5433/geobook
KAFKA_BROKERS=localhost:9092
# Host port only; containers always connect to postgres:5432.
POSTGRES_PORT=5433
# Use true only behind HTTPS. Local Compose uses HTTP.
SECURE_COOKIES=false
SEED_DEMO=true
# Optional: set before the FIRST demo seed to allow demo.owner@geobook.test login.
DEMO_PASSWORD=
MAPBOX_TOKEN=
